{
  "name": "truck-dispatch-calculator",
  "version": "1.0.0",
  "description": "Truck load profitability calculator",
  "main": "main.js",
  "author": "Truck Dispatch Calculator",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.truckdispatch.calculator",
    "productName": "Truck Dispatch Calculator",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Truck Dispatch Calculator",
      "artifactName": "Truck-Dispatch-Calculator-Setup-${version}.${ext}"
    }
  }
}
