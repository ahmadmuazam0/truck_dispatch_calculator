{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Truck Load Calculator",
  "version": "1.0.0",
  "identifier": "com.truckload.calculator",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Truck Load Calculator",
        "width": 1280,
        "height": 850,
        "minWidth": 390,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 24
    }
  }
}