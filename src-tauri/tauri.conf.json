{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Truck Load Calculator",
  "version": "1.0.0",
  "identifier": "com.truckload.calculator",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Truck Load Calculator",
        "width": 1280,
        "height": 850,
        "minWidth": 390,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Truck Load Calculator",
    "shortDescription": "Truck load profit calculator",
    "longDescription": "Truck load profitability, fuel, driver and dispatcher cost calculator.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}